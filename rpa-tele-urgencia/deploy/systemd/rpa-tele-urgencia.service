[Unit]
Description=RPA Tele Urgencia
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cenate
WorkingDirectory=/home/cenate/rpa_tele_urgencia
Environment=ENV_FILE=.env
Environment=RPA_USERS_ENV_FILE=/home/cenate/shared/config/.env_usuarios
Environment=TZ=America/Lima
ExecStart=/home/cenate/rpa_tele_urgencia/scripts/run_rpa_tele_urgencia.sh
TimeoutStartSec=1h
TimeoutStopSec=10min
