[Unit]
Description=RPA Tele Triaje
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cenate
WorkingDirectory=/home/cenate/rpa_tele_triaje
Environment=ENV_FILE=.env
Environment=RPA_USERS_ENV_FILE=/home/cenate/shared/config/.env_usuarios
Environment=TZ=America/Lima
ExecStart=/home/cenate/rpa_tele_triaje/scripts/run_rpa_tele_triaje.sh
TimeoutStartSec=1h
TimeoutStopSec=10min
