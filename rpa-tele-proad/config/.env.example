URL_HOME=http://appsgasistexpl.essalud.gob.pe/explotaDatos/
FRM_HOSPITALIZACION=http://appsgasistexpl.essalud.gob.pe/explotaDatos/servlet/CtrlControl?opt=hosinterser
FRM_EMERGENCIA=http://appsgasistexpl.essalud.gob.pe/explotaDatos/servlet/CtrlControl?opt=emerinterconsulta
GSHEET_URL=https://docs.google.com/spreadsheets/d/REEMPLAZAR/edit
GSHEET_TAB=TELE_PROAD
CREDS_JSON=config/creds_gsheets.json

RPA_USERS_ENV_FILE=../shared/config/.env_usuarios
DEFAULT_MACRO=CENTRO
REQUIRE_MACRO=false

MES_A_PROCESAR=ACTUAL
DOWNLOAD_DIR_HOSPITALIZACION=/mnt/BD_CControl/BASE TELEPROA 2026/HOSPITALIZACION
DOWNLOAD_DIR_EMERGENCIA=/mnt/BD_CControl/BASE TELEPROA 2026/EMERGENCIAS
STAGING_DOWNLOAD_DIR=tmp/downloads

SERVICIO=AJ1
FORMATO_ARCHIVO=xls
FILE_SUFFIX_HOSPITALIZACION=IntercxServ
FILE_SUFFIX_EMERGENCIA=EmerInterconsultaxServ
RUN_HOSPITALIZACION=true
RUN_EMERGENCIA=true

HEADLESS=true
CHROME_PROFILE_BASE_DIR=tmp/chrome_profiles
CHROME_PROFILE_MAX_AGE_HOURS=12
CHROMEDRIVER_LOGS_ENABLED=false
DOWNLOAD_TIMEOUT=900
STABLE_SECS=3
POLL_INTERVAL=2
RETRY_PER_CENTER=1
BETWEEN_DOWNLOADS_DELAY=2
CLEAN_BEFORE=true
PURGE_PARTIALS_AGE_MIN=30
REQUIRE_CENTER=true
DELAY_AFTER_SELECT_CENTER=1
DELAY_AFTER_SUBMIT_CENTER=1
DELAY_BEFORE_OPEN_FORM=1

MAX_CENTERS=0
CENTERS_FILTER=
KEEP_OPEN_SECONDS=0
RUN_NAME=TELE_PROAD
LOGS_DIR=logs
LOG_MODE=PROD
LOG_RETENTION_DAYS=7
LOG_MAX_LIST=50

MAIL_ENABLED=false
SMTP_HOST=
