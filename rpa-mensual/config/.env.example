# RPA Mensual CEXT - ejemplo sin secretos

URL_HOME=
FRM_MASIVAS=

# Fuente de centros/IPRESS:
# - GSHEET mantiene compatibilidad historica.
# - DB_VIEW usa la vista productiva en maestro_cenate.
INPUT_SOURCE=DB_VIEW

GSHEET_URL=
CREDS_JSON=
GSHEET_TABS=ESPECIALIDADES,CENACRON

DB_VIEW_NAME=essi.vw_rpa_mensual_centros_objetivo_v1
INPUT_DB_HOST=
INPUT_DB_PORT=5432
INPUT_DB_DATABASE=maestro_cenate
INPUT_DB_USER=
INPUT_DB_PASSWORD=

# Mes: ACTUAL, ANTERIOR, SIGUIENTE, YYYY-MM o lista separada por comas
MES_A_PROCESAR=ACTUAL

CLOSE_MONTH=false
CLOSE_MONTH_PERIOD=

# Credenciales por macroregion compartidas. No colocar valores reales en Git.
RPA_USERS_ENV_FILE=../shared/config/.env_usuarios

DOWNLOAD_DIRS=
FINAL_PUBLISH_DIR=
FINAL_PUBLISH_MIRRORS=
FINAL_PUBLISH_REPLACE_PERIOD=true

HEADLESS=true
DOWNLOAD_TIMEOUT=1500
BETWEEN_CENTERS_DELAY=2
RETRY_PER_CENTER=1
MAX_THREADS=6
MAX_CONCURRENT_DRIVER_STARTS=1

FORCE_REDOWNLOAD=true
FILE_SUFFIX=PacCitCExt.txt
KEEP_ONLY_CURRENT_TAG=true

RUN_NAME=CEXT_PROD_MENSUAL
LOGS_DIR=logs
LOG_RETENTION_DAYS=14

PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=

SRC241_HOST=
SRC241_PORT=5432
SRC241_DATABASE=
SRC241_USER=
SRC241_PASSWORD=

RPA_JOB_CODE=CEXT_PROD_MENSUAL
RPA_JOB_NAME=RPA Consulta Externa Produccion Mensual
RPA_RUN_TYPE=MENSUAL
RPA_FAIL_IF_DB_DOWN=true

CHROME_PROFILE_BASE_DIR=/opt/rpa/tmp/chrome_profiles
CHROME_PROFILE_MAX_AGE_HOURS=24
CHROMEDRIVER_LOGS_ENABLED=false
HEALTHCHECK_ENABLED=true
HEALTHCHECK_BLOCKING=true
DB_PRECHECK_ENABLED=true
DB_CONNECT_TIMEOUT_SECONDS=5
OVERRIDES_ENABLED=true
FALLBACK_ENABLED=true
OVERRIDE_LEARNING_ENABLED=true
STAGING_LOAD_ENABLED=true
REFRESH_MENSUAL_ENABLED=true

MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
